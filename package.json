{
  "name": "studysync",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build:client": "cd client && npm run build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --outputFile.junit=test-results/unit/junit.xml --reporter=default --reporter=junit",
    "test:integration": "vitest run tests/integration server/tests --outputFile.junit=test-results/integration/junit.xml --reporter=default --reporter=junit",
    "test:api": "vitest run tests/api --outputFile.junit=test-results/api/junit.xml --reporter=default --reporter=junit",
    "test:e2e": "vitest run tests/e2e --outputFile.junit=test-results/e2e/junit.xml --reporter=default --reporter=junit",
    "test:fast": "npm run test:unit && npm run test:integration && npm run test:api",
    "test:daily": "npm run test:fast && npm run test:e2e",
    "test:summary": "node scripts/generate-test-summary.js",
    "test:ci": "vitest run --outputFile.junit=test-results/junit.xml --reporter=default --reporter=junit",
    "typecheck:client": "cd client && tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "audit:security": "npm audit --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.6",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "happy-dom": "^21.0.4",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
